    <origin xyz="0.0301 0 -0.06625" rpy="0 0 0" />
    <parent link="R.ShoulderRotate" />
    <child link="R.ArmRoll" />
    <axis xyz="0 0 -1" />
    <limit lower="-1.5708" upper="1.5708" effort="0" velocity="0" />
  </joint>
  <link name="R.Elbow">
    
    </link>
  <joint name="R.Elbow" type="revolute">
    <origin xyz="0 0.03155 -0.23971" rpy="0 0 0" />
    <parent link="R.ArmRoll" />
    <child link="R.Elbow" />
    <axis xyz="0 -1 0" />
    <limit lower="-0.1" upper="2.3562" effort="0" velocity="0" />
  </joint>
  <link name="R.WristRoll">
    
    </link>
  <joint name="R.WristRoll" type="revolute">
    <origin xyz="0 -0.0315 -0.22444" rpy="0 0 0" />
    <parent link="R.Elbow" />
    <child link="R.WristRoll" />
    <axis xyz="-0.0 -0.0 -1.0" />
    <limit lower="-1.5708" upper="1.5708" effort="0" velocity="0" />
  </joint>
  <link name="R.WristPitch">
    
    </link>
  <joint name="R.WristPitch" type="revolute">
    <origin xyz="0 0 -0.1205" rpy="0 0 0" />
    <parent link="R.WristRoll" />
    <child link="R.WristPitch" />
