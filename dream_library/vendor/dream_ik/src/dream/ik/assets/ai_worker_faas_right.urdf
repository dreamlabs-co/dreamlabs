<?xml version="1.0"?>
<!-- ROBOTIS AI Worker ffw_sg2_follower.urdf: arm_base_link .. arm_r_link7 only (7 movable joints; meshes and every other link
     dropped), the FaaS EEF bake frame. -->
<robot name="ai_worker_faas_right">
  <link name="arm_base_link">
    </link>
  <joint name="arm_r_joint1" type="revolute">
    <parent link="arm_base_link" />
    <child link="arm_r_link1" />
    <origin rpy="0 0 0" xyz="0 -0.1045 0" />
    <axis xyz="0 1 0" />
    <limit effort="1000" lower="-3.14" upper="3.14" velocity="4.8" />
    <dynamics damping="0.1" />
  </joint>
  <link name="arm_r_link1">
    </link>
